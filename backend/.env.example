DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/todotrip

# Development only: any other ENVIRONMENT refuses to start with this value, or
# with anything shorter than 32 characters. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

ENVIRONMENT=development

# Empty locally, and that is correct: every caller really does arrive from its
# own address. Set it only behind a proxy you control, to the header that proxy
# guarantees — "Fly-Client-IP" on Fly.io, "X-Forwarded-For" behind most others.
# Left unset in production, every user shares one rate-limit bucket; set to a
# header the platform does not actually control, anyone can forge their way past
# the limit.
TRUSTED_PROXY_HEADER=
